#!/bin/sh
# `core watch` for harnesses that consume one JSON event per stdout line: a
# Claude Code plugin monitor, omp's declared monitors, and manual smoke tests.
#
# A wrapper, not a second listener: core owns polling, reconnect, persistence,
# redelivery and acking, and its stdout passes through untouched.
#
# An optional first argument names the profile. It is what the monitor
# declaration passes, and an empty one falls back to $MATTERMOST_AGENT_CONFIG.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/mattermost-agent-env.sh"
mattermost_resolve "$_self" "${1:-}"

printf 'mattermost-adapter: watching with config %s\n' "$CONFIG" >&2
mattermost_exec watch
